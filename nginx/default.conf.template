server {
    listen 8080;
    server_name localhost;
    charset utf-8;
    charset_types text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # aicoeprod-subnet is IPv4-only (privateIpv6GoogleAccess: DISABLE_GOOGLE_ACCESS).
    # Without this, nginx resolves Cloud Run's dual-stack .run.app hostnames and wastes
    # a full connect-timeout retrying each unreachable IPv6 address before falling back
    # to a working IPv4 one — real added latency per request, confirmed in prod logs
    # (multiple "Network unreachable" errors per request before success).
    resolver 169.254.169.254 ipv6=off;


    # Security headers for SPA responses (not forced onto upstream API proxies).
    # Intentionally omit X-XSS-Protection (deprecated / can cause issues).
    # CSP kept minimal (frame-ancestors only) so Vite-built assets and inline styles keep working.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    # Browser: fetch identity token with chosen audience (query param)
    location /api/metadata/id-token {
        proxy_pass http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/identity$is_args$args;
        proxy_set_header Metadata-Flavor Google;
    }

    # Architecture B: /api/translation/* and /api/sales/* are routed at the GCLB URL map
    # to THIS backend (aihub-be), not directly to the translation/sales IAP backends.
    # IAP has already authenticated the inbound request for the `aihub` resource by the
    # time nginx sees it, so `X-Goog-IAP-JWT-Assertion` on the request nginx received is
    # scoped to the hub's own IAP audience. A plain proxy_pass forwards that header
    # unchanged to the upstream Cloud Run service. Translation/Sales-Agent's iap_auth.py
    # already accepts this via the HUB_IAP_AUDIENCE fallback audience — no separate IAP
    # session, iframe, or cross-resource CORS handling is required.
    #
    # IMPORTANT: proxy_pass targets the Cloud Run *.run.app URL directly (NOT the
    # dedicated Translation/Sales-Agent internal-DNS/ILB origin). Those services have
    # `ingress: internal` (VPC-only) and IAP is disabled on their own dedicated backend
    # services — routing through the dedicated ILB would never receive a
    # X-Goog-IAP-JWT-Assertion header at all now that its IAP is off. This Cloud Run
    # service (nginx/UI) reaches translation-api-service / sales-research-application's
    # *.run.app URL over Direct VPC egress into the same VPC, which satisfies Cloud
    # Run's `ingress: internal` requirement without making either service public —
    # access is still gated by Cloud Run IAM (roles/run.invoker, granted only to this
    # service's own service account below — no allUsers, satisfying the org policy).
    #
    # CRITICAL: Google Front End (GFE) strips inbound X-Goog-* / X-Google-* request
    # headers at EVERY Cloud Run service's own public ingress edge as an anti-spoofing
    # measure — only IAP itself (sitting directly in front of a given backend) is
    # trusted to set those headers for that backend. Since nginx's outbound call to
    # translation-api-service / sales-research-application looks like an ordinary
    # external request from GFE's perspective at THEIR edge, any X-Goog-IAP-JWT-Assertion
    # header nginx sets gets silently stripped before reaching the FastAPI container —
    # confirmed via prod logs (app-level 401 "Missing X-Goog-IAP-JWT-Assertion header").
    # Fix: relay the same JWT value under a non-reserved custom header name that GFE
    # does not strip; iap_auth.py on both services checks this as a fallback.
    location /api/translation/v1/ {
        proxy_pass ${VITE_TRANSLATION_CLOUD_RUN_URL}/api/v1/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${TRANSLATION_CLOUD_RUN_HOST};
        proxy_pass_request_headers on;
        # Forwarded unchanged from the inbound request — do not strip or rewrite:
        proxy_set_header Authorization $http_authorization;
        proxy_set_header x-app-auth $http_x_app_auth;
        proxy_set_header X-Serverless-Authorization $http_authorization;
        proxy_set_header X-Goog-IAP-JWT-Assertion $http_x_goog_iap_jwt_assertion;
        proxy_set_header X-Goog-Authenticated-User-Email $http_x_goog_authenticated_user_email;
        # GFE-safe relay of the same JWT (see note above) — not an X-Goog-* name:
        proxy_set_header X-Colt-Hub-IAP-Assertion $http_x_goog_iap_jwt_assertion;
    }

    location /api/sales/v1/ {
        proxy_pass ${VITE_SALES_CLOUD_RUN_URL}/api/v1/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${SALES_CLOUD_RUN_HOST};
        proxy_pass_request_headers on;
        # Forwarded unchanged from the inbound request — do not strip or rewrite:
        proxy_set_header Authorization $http_authorization;
        proxy_set_header x-app-auth $http_x_app_auth;
        proxy_set_header X-Serverless-Authorization $http_authorization;
        proxy_set_header X-Goog-IAP-JWT-Assertion $http_x_goog_iap_jwt_assertion;
        proxy_set_header X-Goog-Authenticated-User-Email $http_x_goog_authenticated_user_email;
        # GFE-safe relay of the same JWT (see note above) — not an X-Goog-* name:
        proxy_set_header X-Colt-Hub-IAP-Assertion $http_x_goog_iap_jwt_assertion;
    }


    # Hashed Vite build assets — long cache + security headers
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        # SPA shell must revalidate so users pick up new hashed asset refs
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}
