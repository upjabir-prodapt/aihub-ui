server {
    listen 8080;
    server_name localhost;
    charset utf-8;
    charset_types text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Security headers for SPA responses (not forced onto upstream API proxies).
    # Intentionally omit X-XSS-Protection (deprecated / can cause issues).
    # CSP kept minimal (frame-ancestors only) so Vite-built assets and inline styles keep working.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;

    # Browser: fetch identity token with chosen audience (query param)
    location /api/metadata/id-token {
        proxy_pass http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/identity$is_args$args;
        proxy_set_header Metadata-Flavor Google;
    }

    # Architecture B: /api/translation/* and /api/sales/* are routed at the GCLB URL map
    # to THIS backend (aihub-be), not directly to the translation/sales IAP backends.
    # IAP has already authenticated the inbound request for the `aihub` resource by the
    # time nginx sees it, so `X-Goog-IAP-JWT-Assertion` on the request nginx received is
    # scoped to the hub's own IAP audience. A plain proxy_pass forwards that header
    # unchanged to the upstream Cloud Run service. Translation/Sales-Agent's iap_auth.py
    # already accepts this via the HUB_IAP_AUDIENCE fallback audience — no separate IAP
    # session, iframe, or cross-resource CORS handling is required.
    #
    # IAP itself is disabled on the translation/sales Cloud Run backend services;
    # network-level access control is instead standard Cloud Run IAM
    # (roles/run.invoker granted to this service's own service account), authorized via
    # the Google ID token minted through /api/metadata/id-token above and attached as
    # `Authorization: Bearer <token>` by the browser (see cloudRunAuth.ts / cloudRunIdentity.ts).
    location /api/translation/v1/ {
        proxy_pass ${VITE_TRANSLATION_API_ORIGIN}/api/v1/;
        proxy_ssl_server_name on;
        proxy_ssl_trusted_certificate /etc/nginx/certs/colt-internal-ca.pem;
        proxy_ssl_verify on;
        proxy_set_header Host ${TRANSLATION_API_HOST};
        proxy_pass_request_headers on;
        # Forwarded unchanged from the inbound request — do not strip or rewrite:
        proxy_set_header Authorization $http_authorization;
        proxy_set_header x-app-auth $http_x_app_auth;
        proxy_set_header X-Serverless-Authorization $http_authorization;
        proxy_set_header X-Goog-IAP-JWT-Assertion $http_x_goog_iap_jwt_assertion;
        proxy_set_header X-Goog-Authenticated-User-Email $http_x_goog_authenticated_user_email;
    }

    location /api/sales/v1/ {
        proxy_pass ${VITE_SALES_API_ORIGIN}/api/v1/;
        proxy_ssl_server_name on;
        proxy_ssl_trusted_certificate /etc/nginx/certs/colt-internal-ca.pem;
        proxy_ssl_verify on;
        proxy_set_header Host ${SALES_API_HOST};
        proxy_pass_request_headers on;
        # Forwarded unchanged from the inbound request — do not strip or rewrite:
        proxy_set_header Authorization $http_authorization;
        proxy_set_header x-app-auth $http_x_app_auth;
        proxy_set_header X-Serverless-Authorization $http_authorization;
        proxy_set_header X-Goog-IAP-JWT-Assertion $http_x_goog_iap_jwt_assertion;
        proxy_set_header X-Goog-Authenticated-User-Email $http_x_goog_authenticated_user_email;
    }

    # Hashed Vite build assets — long cache + security headers
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        # SPA shell must revalidate so users pick up new hashed asset refs
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}
