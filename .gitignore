# Node.js dependencies
node_modules/

# Production
/dist/
/build/

# Vite cache
/.vite/

# Next.js build output
.next/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (keep .env.example committed)
.env
.env.*
!.env.example

# System files
.DS_Store
Thumbs.db

# IDE/editor folders
.vscode/
.idea/

# OS generated files
*.log

# Certificates and local server config
certs/

# Generated at build time from nginx/default.conf.template
nginx/default.conf

# Temporary files
*.tmp
*.temp

# Lock files if generated by local package managers (keep package-lock.json if committed)
# pnpm-lock.yaml
# yarn.lock
memmory-bank
