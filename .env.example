# AI Hub UI — environment variables
# Copy to .env.local (local overrides), .env.development, .env.sandbox, or .env.production
# Vite loads .env.[mode] based on --mode (sandbox | development | production)
#
# GitLab CI: set the same VITE_* keys as environment-scoped variables (sandbox / dev / prod)
# and pass them as Docker --build-arg in build-and-push (see .gitlab-ci.yml).

# ── Translation API ──────────────────────────────────────────────────────────
# Internal DNS host proxied by Nginx (prod) / Vite (dev)
VITE_TRANSLATION_API_ORIGIN=https://translation.aicoesandox-int.colt.net
# Cloud Run .run.app URL — IAM identity token audience (not the DNS host above)
VITE_TRANSLATION_CLOUD_RUN_URL=https://translation-api-service-297743845367.europe-west1.run.app

# ── Sales Agent API ──────────────────────────────────────────────────────────
VITE_SALES_API_ORIGIN=https://salesagent.aicoesandox-int.colt.net
VITE_SALES_CLOUD_RUN_URL=https://sales-research-application-297743845367.europe-west1.run.app

# ── Contract management API ──────────────────────────────────────────────────
VITE_CONTRACTS_API_BASE=http://localhost:5010/api

# ── GCP metadata (display / diagnostics) ─────────────────────────────────────
VITE_GCP_PROJECT_ID=aicoesandox
VITE_GCP_PROJECT_NUMBER=297743845367
VITE_GCP_REGION=europe-west1

# ── TLS ──────────────────────────────────────────────────────────────────────
VITE_TLS_CA_FILE=certs/colt-internal-ca.pem

# ── Per-environment reference (replace placeholders for dev/prod) ─────────────
#
# sandbox (current defaults — see .env.sandbox)
# dev     — set GitLab environment-scoped vars on branch `dev`
# prod    — set GitLab environment-scoped vars on branch `prod`
#
# GitLab CI/CD variables (group + per-environment scope):
#   WORKLOAD_IDENTITY_PROJECT_NUMBER, WORKLOAD_IDENTITY_POOL,
#   WORKLOAD_IDENTITY_PROVIDER, SERVICE_ACCOUNT,
#   GCP_PROJECT_ID, GCP_REGION, ARTIFACT_REPO, IMAGE_NAME,
#   CLOUD_RUN_SERVICE, CLOUD_RUN_NETWORK, CLOUD_RUN_SUBNET, CLOUD_RUN_SA
